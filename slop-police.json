{
  "projects": [
    "packages/api/tsconfig.json",
    "packages/frontend/tsconfig.app.json",
    "packages/frontend/tsconfig.node.json",
    "packages/landing/tsconfig.json"
  ],
  "ignore": ["**/routeTree.gen.ts"],
  "testFiles": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.mock.{ts,tsx}"
  ],
  "rules": {
    "unused-methods": "error",
    "unused-object-keys": "error",
    "no-identity-type-alias": "error",
    "no-pass-through-getter": "error",
    "no-redundant-value-alias": "error",
    "no-single-string-cn": "error",
    "no-placeholder-comment": "error",
    "no-pass-through-wrapper": "error",
    "no-duplicate-function": "error",
    "no-stringified-unknown-error": "error"
  }
}
