{
  "projects": [
    "packages/api/tsconfig.json",
    "packages/frontend/tsconfig.app.json",
    "packages/frontend/tsconfig.node.json",
    "packages/landing/tsconfig.json"
  ],
  "ignore": [
    "**/routeTree.gen.ts",
    "packages/landing/src/components/landing-page/proPlanSection.tsx",
    "packages/frontend/src/ui/shadcn/**",
    "packages/landing/src/components/ui/**"
  ],
  "testFiles": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.mock.{ts,tsx}",
    "**/*.test-d.ts"
  ],
  "rules": {
    "unused-exports": [
      "error",
      {
        "entry": [
          "packages/*/vite.config.ts",
          "packages/api/src/index.ts",
          "packages/api/bin/*.ts",
          "packages/api/migrate.ts",
          "packages/api/drizzle.config.ts",
          "packages/api/vitest.config.mts",
          "packages/frontend/src/main.tsx",
          "packages/frontend/playground/main.tsx",
          "packages/landing/src/routes/**/*.tsx",
          "packages/landing/src/router.tsx"
        ]
      }
    ]
  }
}
