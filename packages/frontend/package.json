{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "pnpm exec tsrs -b --noEmit",
    "lint": "oxlint --format=agent . && stylelint \"src/**/*.css\"",
    "test": "pnpm exec vitest run --environment jsdom --typecheck",
    "build": "vite build",
    "build:playground": "BUILD_PLAYGROUND=1 vite build",
    "size": "vite build && size-limit",
    "bundle-analyze": "analyze --mode=server --open=false --port=8888 --summary=false"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@trpc/client": "^11.18.0",
    "api": "workspace:*",
    "autosize": "^6.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "^0.1.8",
    "date-fns": "^4.4.0",
    "dompurify": "^3.0.9",
    "easy-speech": "2.4.1-rc.1",
    "lucide-react": "^0.479.0",
    "mathml-tag-names": "^3.0.2",
    "mobx": "^7.0.4",
    "mobx-form-lite": "^0.9.7",
    "mobx-persist-store": "^1.1.8",
    "mobx-query-lite": "^0.1.0",
    "mobx-react-lite": "^5.1.2",
    "motion": "^14.0.0",
    "preact": "^11.0.0",
    "react-google-one-tap-login": "^0.1.1",
    "tailwind-merge": "^3.0.1",
    "valibot": "^1.4.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/autosize": "^4.0.3",
    "@types/node": "^25.9.1",
    "@types/telegram-web-app": "^9.6.0",
    "eruda": "3.4.3",
    "jsdom": "^26.1.0",
    "mobx-react-plugin": "^1.0.1",
    "oxlint": "^1.70.0",
    "rollbar": "2.26.0",
    "size-limit": "^14.3.0",
    "stylelint": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.16",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^5.1.0"
  }
}
