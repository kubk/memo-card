{
  "name": "memo-card",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "kill-ports": "bash -lc 'for port in 8780 5180 8080; do lsof -ti :\"$port\"; done | xargs kill 2>/dev/null || true; echo \"Ports cleared\"'",
    "dev": "pnpm run kill-ports && concurrently -n api,frontend,landing -c green,blue,magenta --kill-others-on-fail \"pnpm run -F=api dev\" \"pnpm run -F=frontend dev\" \"pnpm run -F=landing dev\"",
    "dev:telegram": "pnpm run kill-ports && concurrently -n api,frontend,tunnel -c green,blue,yellow --kill-others-on-fail \"pnpm run -F=api dev\" \"pnpm run -F=frontend dev\" \"pnpm run -F=api tunnel\"",
    "format": "oxfmt --write \"./packages/**/*.{ts,tsx,mts,json}\"",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:packages": "pnpm --recursive --parallel --filter='./packages/*' run lint",
    "lint:duplicates": "jscpd packages/api/src packages/frontend/src --min-lines 10 --min-tokens 50 --cross-formats js-ts --ignore \"**/*.test.*\" --skip-isolated \"packages/api|packages/frontend\" --exit-code 1 --no-colors --no-tips",
    "lint:knip": "knip --reporter compact",
    "lint:slop-api": "slop-scan scan packages/api --lint | tee /dev/stderr | grep -q '^0 findings$'",
    "lint:slop-frontend": "slop-scan scan packages/frontend --lint | tee /dev/stderr | grep -q '^0 findings$'",
    "lint:translations": "node packages/frontend/check-missing-translations.js",
    "lint:methods-api": "node tools/detect-unused-methods/index.mjs packages/api",
    "lint:methods-frontend": "node tools/detect-unused-methods/index.mjs packages/frontend",
    "typecheck": "pnpm --recursive --parallel --filter='./packages/*' run typecheck",
    "test": "pnpm run -F='./packages/*' test",
    "filter-public-code": "git-filter git-filter.config.json",
    "export-public-code": "./export-public-code.sh",
    "postinstall": "patch-package",
    "dead-code": "pnpm run \"/^lint:(knip|slop-.*)$/\"",
    "detect-unused-methods": "pnpm run \"/^lint:methods-.*/\""
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "mobx-react-observer>mobx-react-lite": "^5.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "mobx-form-lite>mobx": "7"
      }
    }
  },
  "dependencies": {
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "git-filter": "2.4.1",
    "jscpd": "^5.1.2",
    "knip": "^6.9.0",
    "oxfmt": "^0.55.0",
    "slop-scan": "^0.3.0",
    "typescript": "^7.0.2",
    "typescript-api6": "workspace:*"
  }
}
